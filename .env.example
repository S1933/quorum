# ============================================================
# Quorum — Environment Variables
# ============================================================
# Copy to .env and fill in values you need:
#   cp .env.example .env
#
# Quorum resolves `env:VAR_NAME` references from quorum.yaml.
# The .env file is loaded automatically if dotenv is configured,
# otherwise export these in your shell profile.

# ── API-based providers ──────────────────────────────────────

# OpenRouter API key (required for openrouter provider)
# Get one at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...

# Ollama host (optional, defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ── Subprocess providers ─────────────────────────────────────
# These do NOT need env vars — they use credentials configured
# inside the CLI tool itself. You just need the CLI installed.
#
#   Provider        Required CLI    Install command
#   ─────────       ─────────────   ──────────────────────────────
#   claude-code     claude          npm install -g @anthropic-ai/claude-code
#   codex-cli       codex           npx codex (or see OpenAI docs)
#   gemini-cli      gemini          npm install -g @google/gemini-cli
#   cursor-agent    cursor-agent    (bundled with Cursor IDE)
#   kilo-code       kilocode        npm install -g @kilo-ai/kilocode
#   opencode        opencode        npm install -g @opencode-ai/cli
